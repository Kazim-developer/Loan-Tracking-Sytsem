generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  accounts           Account[]
  passwordRestTokens PasswordResetToken[]
}

model Account {
  id                String              @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  passwordHash      String?
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  imageUrl          String?
  name              String?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients           Client[]
  loans             Loan[]
  sessions          Session[]
  subscription      Subscription?
  subscriptionAddOn SubscriptionAddOn[]
  usage             Usage?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  loans     Loan[]

  @@unique([accountId, email])
  @@index([accountId])
}

model Loan {
  id                   String            @id @default(uuid())
  clientId             String
  totalAmount          Float
  interestRate         Float?
  interestType         InterestType?
  hasInstallments      Boolean           @default(false)
  installmentAmount    Float?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  endDate              DateTime?
  firstInstallmentDate DateTime?
  totalPayable         Float
  lastInstallmentDate  DateTime?
  installmentFrequency Frequency?
  startingDate         DateTime
  status               LoanStatus        @default(ACTIVE)
  totalInstallments    Int?
  accountId            String
  repaymentStatus      RepaymentStatus   @default(PENDING)
  account              Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  installments         LoanInstallment[]
  loanPayments         LoanPayment[]
  loanReminders        Reminder[]

  @@index([accountId])
  @@index([accountId, status])
  @@index([accountId, repaymentStatus])
  @@index([accountId, createdAt])
}

model LoanInstallment {
  id                   String            @id @default(uuid())
  loanId               String
  dueDate              DateTime
  amount               Float
  status               InstallmentStatus @default(PENDING)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  paidAt               DateTime?
  loan                 Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentReminders Reminder[]

  @@index([loanId])
  @@index([loanId, status])
  @@index([loanId, dueDate])
}

model LoanPayment {
  id        String   @id @default(uuid())
  loanId    String
  amount    Float
  createdAt DateTime @default(now())
  paidAt    DateTime @default(now())
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([loanId, paidAt])
}

model Reminder {
  id            String           @id @default(uuid())
  reminderDate  DateTime
  sent          Boolean          @default(false)
  type          ReminderType
  createdAt     DateTime         @default(now())
  installmentId String?
  loanId        String?
  installment   LoanInstallment? @relation(fields: [installmentId], references: [id])
  loan          Loan?            @relation(fields: [loanId], references: [id])
}

model Plan {
  id                   String         @id @default(uuid())
  name                 String         @unique
  priceMonth           Int
  createdAt            DateTime       @default(now())
  description          String?
  isActive             Boolean        @default(true)
  priceYear            Int?
  updatedAt            DateTime       @updatedAt
  maxEmailReminders    Int?
  maxTeamMembers       Int?
  maxWhatsappReminders Int?
  monthlyPriceId       String?        @unique
  maxActiveLoans       Int?
  maxClients           Int?
  maxTotalLoans        Int?
  features             PlanFeature[]
  subscriptions        Subscription[]
}

model PlanFeature {
  id      String  @id @default(uuid())
  planId  String
  key     String
  enabled Boolean
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
}

model Subscription {
  id                     String             @id @default(uuid())
  planId                 String
  status                 SubscriptionStatus
  startDate              DateTime
  endDate                DateTime?
  cancelAt               DateTime?
  createdAt              DateTime           @default(now())
  accountId              String             @unique
  autoRenew              Boolean            @default(true)
  billingCycle           BillingCycle
  provider               String             @default("paddle")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  updatedAt              DateTime           @updatedAt
  account                Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([accountId])
  @@index([providerCustomerId])
}

model SubscriptionAddOn {
  id                  String    @id @default(uuid())
  accountId           String
  type                AddOnType
  quantity            Int
  used                Int       @default(0)
  paddleTransactionId String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  eventType   String
}

model Usage {
  id                 String    @id @default(uuid())
  accountId          String    @unique
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  usedActiveLoans    Int       @default(0)
  usedClients        Int       @default(0)
  usedEmailReminders Int       @default(0)
  usedTotalLoans     Int       @default(0)
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum InterestType {
  SIMPLE
  COMPOUND
}

enum Frequency {
  WEEKLY
  MONTHLY
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum RepaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  DUE
}

enum InstallmentStatus {
  PENDING
  PAID
  DUE
  OVERDUE
}

enum ReminderType {
  EMAIL
  WHATSAPP
}

enum AddOnType {
  EMAIL_REMINDERS
  WHATSAPP_REMINDERS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PAST_DUE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}
